#!/usr/bin/env bash
# crousandgo: single entry point. Works from anywhere (also through a symlink).
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ "$src" != /* ]] && src="$dir/$src"
done
HERE="$(cd "$(dirname "$src")/.." && pwd)"
PY="$HERE/.venv/bin/python"
[ -x "$PY" ] || { echo "crousandgo: run $HERE/install.sh first" >&2; exit 1; }

case "${1:-help}" in
  serve) shift; exec "$PY" "$HERE/server.py" "$@" ;;
  login|menus|ask|order|watch) exec "$PY" "$HERE/cli.py" "$@" ;;
  *) cat <<'H'
crousandgo <command>

  login [--manual]                    create/refresh the session (headless with CROUS_USER/CROUS_PASS)
  menus                               what is published right now
  ask [--no-mark]                     the 20:00 question, or nothing (already ordered / already asked)
  order DATE PLAT P1 P2 [--service midi|soir] [--yes]
                                      dry run unless --yes (needs CROUSGO_ENABLE_WRITES=1)
  watch DATE PLAT P1 P2 [--service ..]   wait for 13:00 the day before, order as soon as the menu appears
  serve [--http PORT] [--read-only]   run the MCP server
H
  ;;
esac
