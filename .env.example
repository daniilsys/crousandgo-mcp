# Copy to ~/.config/crousandgo/.env (or ./.env), chmod 600. Never commit.
CROUS_USER=
CROUS_PASS=
IZLY_USER=
IZLY_PASS=

# Kill switch: real orders are refused unless this is 1
CROUSGO_ENABLE_WRITES=0
# Max real orders per server process
CROUSGO_MAX_ORDERS=1
# Language of the evening question (en or fr)
CROUSGO_LANG=en

# Izly top-up (tool topup_izly), with a card saved on the Izly account (Recharger > carte bancaire).
# The agent asks you first, then you approve the payment in your bank app while it waits.
IZLY_TOPUP_EUR=5
# Saved card to use: any part of its label in Izly's list, e.g. the last 4 digits (empty = first card)
IZLY_TOPUP_CARD=
# Seconds to wait for your approval at the bank
IZLY_TOPUP_WAIT_S=300
CROUSGO_MAX_TOPUPS=1
